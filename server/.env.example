# Local / staging DB (Supabase or local Postgres). Use the production connection string on Render.
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="3d"
PORT=4000
NODE_ENV=development
# Comma-separated browser origins. Locally include both localhost and 127.0.0.1 for each app.
# On hosting, replace with your real site URLs, e.g.:
# CORS_ORIGIN="https://sales.example.com,https://leads.example.com"
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"
BUYER_JWT_SECRET="replace-with-a-different-long-random-string"
BUYER_JWT_EXPIRES_IN="8h"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"

# --- Gov grants engine (in-process background crawl loop) ---
# Master switch. Off => no crawling at all.
GRANTS_ENGINE_ENABLED="false"
# Minutes between crawl cycles (ms). Min 60000.
GRANTS_CRAWL_INTERVAL_MS="1800000"
# Per-request crawl timeout (ms) — stops one hung gov portal stalling a cycle.
GRANTS_FETCH_TIMEOUT_MS="20000"
# Cycles a crawled link may go unseen on its portal before auto-retirement.
GRANTS_STALE_CYCLES="3"

# EMAIL SAFETY — real delivery is OFF unless this is exactly "true".
# Before switching on: POST /api/v1/grants/suppress-backlog (FOUNDER) so the
# historical pending backlog is NOT blasted at real client inboxes.
GRANTS_NOTIFY_ENABLED="false"
GRANTS_NOTIFY_MAX_PER_RUN="25"
GRANTS_NOTIFY_WEBHOOK=""

# Zoho SMTP. Set these in the Render dashboard — never commit real values.
# Use a Zoho APP PASSWORD, not the account login password.
# From must match the authenticated mailbox or a verified alias, or Zoho rejects it.
GRANTS_SMTP_HOST="smtp.zoho.in"
GRANTS_SMTP_PORT="465"
GRANTS_SMTP_USER="team@naraway.com"
GRANTS_SMTP_PASS=""
GRANTS_SMTP_FROM="Naraway Grants <team@naraway.com>"
# Zoho counts each BCC recipient against the mailbox quota; cohorts split at this size.
GRANTS_SMTP_MAX_RECIPIENTS_PER_MSG="50"
GRANTS_TEAM_EMAIL="team@naraway.com"

# Public app URL used in client-facing email links.
APP_BASE_URL="http://localhost:5173"

# Team-curated Google Sheet pulled in as a scheme source (public CSV, no Sheets API).
SCHEME_SHEET_ID="14qJbsYr9OVx72WfSrlUXnn8LWHqf0PRpmLDeffzgUzY"
SCHEME_SHEET_NAME="Sheet1"
SCHEME_HTTP_USER_AGENT="NarawayGrantsEngine/1.0 (+https://naraway.com; support@naraway.com)"

# Sample clients seed only outside production; set false to disable locally too.
GRANTS_ALLOW_SAMPLE_DATA="true"
